{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owismind/workspace_protocol/v1",
  "title": "OWIsMind workspace event protocol v1",
  "description": "Shared contract between the orchestrator Code Agent (eventKind WORKSPACE), the Flask backend (owismind.workspace) and the Vue frontend (composables/workspaceModel.js). Backend and frontend both read this file (parity tests). Additive changes only; a breaking change is a new file v2.",
  "version": 1,
  "caps": {
    "max_plan_steps": 10,
    "max_notes": 30,
    "max_widgets": 12,
    "max_provenance": 24,
    "max_workspace_events_per_run": 80,
    "max_workspace_json_chars": 200000,
    "mission_chars": 240,
    "step_label_chars": 140,
    "note_title_chars": 140,
    "note_text_chars": 1200,
    "widget_title_chars": 200,
    "widget_comment_chars": 280,
    "widget_text_chars": 4000,
    "task_chars": 800,
    "max_y_series": 8,
    "max_carry_remove": 12,
    "suggestions_max_items": 3,
    "suggestion_min_chars": 8,
    "suggestion_max_chars": 120
  },
  "enums": {
    "ops": ["plan.set", "plan.step", "note.add", "widget.add", "prov.set", "studio.continue", "widget.remove", "studio.carry", "suggest.set"],
    "plan_origins": ["model", "auto"],
    "step_statuses": ["todo", "running", "done", "error"],
    "note_kinds": ["plan", "find", "check", "note", "done"],
    "widget_kinds": ["chart", "table", "kpi", "text"],
    "chart_types": ["bar", "line", "pie", "donut"],
    "chart_styles": ["grouped", "stacked", "horizontal", "area", "smooth", "stepped", "donut"],
    "bindings": ["explicit", "orphan"],
    "run_statuses": ["running", "done", "stopped", "error"],
    "tools": ["semantic-model-query", "attribute_lookup", "correlate"],
    "widget_sizes": ["normal", "wide"],
    "text_roles": ["section", "scope"]
  },
  "patterns": {
    "sql_id": "^s[0-9]+(q|lk|qc)[0-9]+$",
    "slug": "^[a-z0-9_-]{1,32}$",
    "exchange_id": "^[A-Za-z0-9_-]{1,128}$"
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
    "sqlId": {"type": "string", "pattern": "^s[0-9]+(q|lk|qc)[0-9]+$"},
    "exchangeId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "envelope": {
      "type": "object",
      "required": ["v", "op", "seq"],
      "properties": {
        "v": {"const": 1},
        "op": {"enum": ["plan.set", "plan.step", "note.add", "widget.add", "prov.set", "studio.continue", "widget.remove", "studio.carry", "suggest.set"]},
        "seq": {"type": "integer", "minimum": 1},
        "ts": {"type": "number", "minimum": 0, "description": "Seconds since run start; stamped by the backend when absent."}
      }
    },
    "planStep": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "label": {"type": "string", "maxLength": 140},
        "total": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "maxLength": 40}
      }
    },
    "chartSpec": {
      "type": "object",
      "required": ["type", "x", "y"],
      "properties": {
        "type": {"enum": ["bar", "line", "pie", "donut"]},
        "x": {"type": "string", "maxLength": 128},
        "y": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 128}},
        "style": {"enum": ["grouped", "stacked", "horizontal", "area", "smooth", "stepped", "donut"]},
        "x_label": {"type": "string", "maxLength": 80},
        "y_label": {"type": "string", "maxLength": 80},
        "unit": {"type": "string", "maxLength": 16}
      }
    },
    "kpiSpec": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "maxLength": 120},
        "value": {"type": "string", "maxLength": 128, "description": "Exact column name of the bound result."},
        "delta": {"type": "string", "maxLength": 128},
        "delta_pct": {"type": "string", "maxLength": 128},
        "unit": {"type": "string", "maxLength": 16}
      }
    }
  },
  "events": {
    "plan.set": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["mission", "steps", "origin"],
      "properties": {
        "mission": {"type": "string", "maxLength": 240},
        "origin": {"enum": ["model", "auto"]},
        "steps": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/planStep"}}
      }
    },
    "plan.step": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["step_id"],
      "properties": {
        "step_id": {"$ref": "#/$defs/slug"},
        "status": {"enum": ["todo", "running", "done", "error"]},
        "done": {"type": "integer", "minimum": 0},
        "add_step": {"$ref": "#/$defs/planStep"}
      }
    },
    "note.add": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["id", "kind", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "step_id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["plan", "find", "check", "note", "done"]},
        "title": {"type": "string", "maxLength": 140},
        "text": {"type": "string", "maxLength": 1200},
        "sql_id": {"$ref": "#/$defs/sqlId"}
      }
    },
    "widget.add": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["id", "kind", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "step_id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["chart", "table", "kpi", "text"]},
        "title": {"type": "string", "maxLength": 200},
        "comment": {"type": "string", "maxLength": 280},
        "sql_id": {"$ref": "#/$defs/sqlId", "description": "REQUIRED when kind is chart, table or kpi. Never a fallback to the latest result."},
        "size": {"enum": ["normal", "wide"], "description": "Optional width hint, kept on chart and table only (dropped on kpi and text)."},
        "role": {"enum": ["section", "scope"], "description": "Optional, text only: 'scope' is the analysis scope shown in the Studio header, not on the board. Default 'section'."},
        "chart": {"$ref": "#/$defs/chartSpec"},
        "kpi": {"$ref": "#/$defs/kpiSpec"},
        "text": {"type": "string", "maxLength": 4000, "description": "REQUIRED when kind is text. Markdown, rendered through the sanitized markdown pipeline."},
        "binding": {"enum": ["explicit", "orphan"], "description": "Set by the backend at persistence: orphan when sql_id matches no captured SQL of the run."},
        "replaces": {"$ref": "#/$defs/slug", "description": "Optional: id of a widget already in the state; the new widget takes its board position and the old one is removed. Op attribute only, never stored. widget.add never accepts 'origin'."}
      }
    },
    "prov.set": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["sql_id", "agent_key", "tool", "success"],
      "properties": {
        "sql_id": {"$ref": "#/$defs/sqlId"},
        "agent_key": {"type": "string", "maxLength": 64},
        "tool": {"enum": ["semantic-model-query", "attribute_lookup", "correlate"]},
        "task": {"type": "string", "maxLength": 800},
        "step_id": {"$ref": "#/$defs/slug"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "row_count": {"type": "integer", "minimum": 0},
        "success": {"type": "boolean"}
      }
    },
    "studio.continue": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "description": "The orchestrator decided to CONTINUE the Studio the user sees (base resolved and validated server side, never sent by the agent). With a valid base the backend relays a studio.carry with the SAME seq in its place; without one it is a no-op.",
      "properties": {
        "remove": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/slug"}, "description": "Ids of base widgets NOT carried (unknown ids ignored)."}
      }
    },
    "widget.remove": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}
      }
    },
    "studio.carry": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "description": "Backend-generated only (rejected on the agent stream). Prepends the base widgets (minus remove) before the widgets of this run, capped at max_widgets; applied once per run.",
      "required": ["base_exchange_id", "widgets"],
      "properties": {
        "base_exchange_id": {"$ref": "#/$defs/exchangeId"},
        "widgets": {"type": "array", "maxItems": 12, "items": {"type": "object", "description": "A widget.add payload without step_id / ts, plus binding (data widgets) and origin (the exchange that owns its SQL).", "required": ["id", "kind", "title", "origin"], "properties": {"origin": {"$ref": "#/$defs/exchangeId"}}}}
      }
    },
    "suggest.set": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "description": "The 2 or 3 next analyses proposed under the answer ('Go further' chips), in the reply language; a click sends the text as the next user message. Emitted once, right before the final answer. Last op wins. Never carried by studio.carry, ignored by summary / finalize; a workspace holding only suggestions never opens the Studio.",
      "required": ["items"],
      "properties": {
        "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 8, "maxLength": 120}, "description": "Each item is stripped then kept only when its length (Unicode code points, JS [...s].length) is within [8, 120]: an out-of-bounds or non-string item is DROPPED (never truncated). Duplicates removed case- and whitespace-insensitively (lowercase + whitespace runs collapsed), first occurrence kept as stripped; more than 3 valid -> the first 3. No valid item left (or items not an array) -> the op is dropped."}
      }
    }
  },
  "reduced_state": {
    "description": "Shape stored in webapp_workspaces_v1.workspace and served by GET /workspace. Rows are never stored here; they are joined by sql_id at read time.",
    "type": "object",
    "required": ["v", "status", "plan", "notes", "widgets", "provenance"],
    "properties": {
      "v": {"const": 1},
      "status": {"enum": ["running", "done", "stopped", "error"]},
      "exchange_id": {"type": "string"},
      "base_exchange_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$", "description": "Set when this Studio continues another one (studio.carry)."},
      "plan": {
        "type": ["object", "null"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "origin": {"enum": ["model", "auto"]},
          "mission": {"type": "string"},
          "steps": {"type": "array", "items": {
            "type": "object",
            "required": ["id", "label", "status"],
            "properties": {
              "id": {"type": "string"}, "label": {"type": "string"},
              "status": {"enum": ["todo", "running", "done", "error"]},
              "done": {"type": "integer"}, "total": {"type": "integer"}, "unit": {"type": "string"}
            }
          }}
        }
      },
      "notes": {"type": "array", "items": {"type": "object"}},
      "widgets": {"type": "array", "items": {"type": "object", "description": "A carried widget has 'origin' (pattern exchange_id): its sql_id resolves against THAT exchange."}},
      "provenance": {"type": "object", "additionalProperties": {"type": "object"}},
      "suggestions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 8, "maxLength": 120}, "description": "Items of the last valid suggest.set. ABSENT when there is none (never an empty list): read it as state.suggestions || []."},
      "summary": {"type": "object"}
    }
  }
}
