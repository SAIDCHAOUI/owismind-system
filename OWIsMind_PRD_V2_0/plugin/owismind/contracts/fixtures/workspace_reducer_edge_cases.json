{
  "name": "workspace_reducer_edge_cases",
  "description": "Reducer semantics shared by backend (workspace/reducer.py) and frontend (composables/workspaceModel.js): fold 'events' from the empty state and compare with 'expected' (deep equality).",
  "cases": [
    {
      "name": "empty",
      "description": "No event: the empty state.",
      "events": [],
      "expected": {
        "v": 1,
        "status": "running",
        "last_seq": 0,
        "plan": null,
        "notes": [],
        "widgets": [],
        "provenance": {},
        "summary": {
          "widget_ids_by_step": {},
          "sql_ids": []
        }
      }
    },
    {
      "name": "plan_step_before_plan_ignored_and_replay_dropped",
      "description": "plan.step without plan = no-op but seq advances; seq <= last_seq = replay ignored; unknown step_id = no-op.",
      "events": [
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 1,
          "step_id": "p1",
          "status": "running"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.set",
          "seq": 2,
          "ts": 1.0,
          "mission": "M",
          "origin": "model",
          "steps": [
            {
              "id": "p1",
              "label": "A"
            }
          ]
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 2,
          "step_id": "p1",
          "status": "done"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 1,
          "step_id": "p1",
          "status": "error"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 3,
          "step_id": "zz",
          "status": "done"
        }
      ],
      "expected": {
        "v": 1,
        "status": "running",
        "last_seq": 3,
        "plan": {
          "version": 1,
          "origin": "model",
          "mission": "M",
          "steps": [
            {
              "id": "p1",
              "label": "A",
              "status": "todo"
            }
          ]
        },
        "notes": [],
        "widgets": [],
        "provenance": {},
        "summary": {
          "widget_ids_by_step": {},
          "sql_ids": []
        }
      }
    },
    {
      "name": "plan_replacement_bumps_version_keeps_widgets",
      "description": "A second plan.set replaces the plan (version 2); widgets keep their (now removed) step_id.",
      "events": [
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.set",
          "seq": 1,
          "mission": "M1",
          "origin": "auto",
          "steps": [
            {
              "id": "p1",
              "label": "A"
            }
          ]
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "widget.add",
          "seq": 2,
          "ts": 2.0,
          "id": "w1",
          "step_id": "p1",
          "kind": "text",
          "title": "T",
          "text": "x"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 3,
          "step_id": "p1",
          "status": "done"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.set",
          "seq": 4,
          "mission": "M2",
          "origin": "model",
          "steps": [
            {
              "id": "q1",
              "label": "B",
              "total": 2
            }
          ]
        }
      ],
      "expected": {
        "v": 1,
        "status": "running",
        "last_seq": 4,
        "plan": {
          "version": 2,
          "origin": "model",
          "mission": "M2",
          "steps": [
            {
              "id": "q1",
              "label": "B",
              "status": "todo",
              "total": 2,
              "done": 0
            }
          ]
        },
        "notes": [],
        "widgets": [
          {
            "id": "w1",
            "step_id": "p1",
            "kind": "text",
            "title": "T",
            "text": "x",
            "ts": 2.0
          }
        ],
        "provenance": {},
        "summary": {
          "widget_ids_by_step": {
            "p1": [
              "w1"
            ]
          },
          "sql_ids": []
        }
      }
    },
    {
      "name": "add_step_then_status_and_cap",
      "description": "add_step appends then status applies to it; an 11th step is refused (cap 10) so its status is a no-op; add_step with an existing id is ignored but done still applies.",
      "events": [
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.set",
          "seq": 1,
          "mission": "M",
          "origin": "model",
