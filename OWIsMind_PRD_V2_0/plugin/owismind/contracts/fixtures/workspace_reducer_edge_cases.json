    {
      "name": "duplicate_ids_first_wins_and_prov_overwrite",
      "description": "Duplicate note/widget id: first wins. prov.set on a known sql_id replaces the entry entirely and keeps its position. sql_ids order = provenance keys, then widgets, then notes.",
      "events": [
        {
          "type": "workspace",
          "v": 1,
          "op": "note.add",
          "seq": 1,
          "ts": 1.0,
          "id": "n1",
          "kind": "note",
          "title": "first"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "note.add",
          "seq": 2,
          "ts": 2.0,
          "id": "n1",
          "kind": "note",
          "title": "second"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "widget.add",
          "seq": 3,
          "ts": 3.0,
          "id": "w1",
          "kind": "table",
          "title": "first",
          "sql_id": "s1q1"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "widget.add",
          "seq": 4,
          "ts": 4.0,
          "id": "w1",
          "kind": "table",
          "title": "second",
          "sql_id": "s2q1"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "prov.set",
          "seq": 5,
          "sql_id": "s1q1",
          "agent_key": "revenue",
          "tool": "semantic-model-query",
          "success": false,
          "duration_ms": 10
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "prov.set",
          "seq": 6,
          "sql_id": "s0q1",
          "agent_key": "tickets",
          "tool": "attribute_lookup",
          "success": true
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "prov.set",
          "seq": 7,
          "sql_id": "s1q1",
          "agent_key": "revenue",
          "tool": "semantic-model-query",
          "success": true,
          "row_count": 5
        }
      ],
      "expected": {
        "v": 1,
        "status": "running",
        "last_seq": 7,
        "plan": null,
        "notes": [
          {
            "id": "n1",
            "kind": "note",
            "title": "first",
            "ts": 1.0
          }
        ],
        "widgets": [
          {
            "id": "w1",
            "kind": "table",
            "title": "first",
            "sql_id": "s1q1",
            "binding": "explicit",
            "ts": 3.0
          }
        ],
        "provenance": {
          "s1q1": {
            "agent_key": "revenue",
            "tool": "semantic-model-query",
            "row_count": 5,
            "success": true
          },
          "s0q1": {
            "agent_key": "tickets",
            "tool": "attribute_lookup",
            "success": true
          }
        },
        "summary": {
          "widget_ids_by_step": {},
          "sql_ids": [
            "s1q1",
            "s0q1"
          ]
        }
      }
    },
