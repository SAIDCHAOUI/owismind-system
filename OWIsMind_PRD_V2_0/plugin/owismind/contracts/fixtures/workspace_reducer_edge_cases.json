            },
            {
              "id": "p8",
              "label": "S8"
            },
            {
              "id": "p9",
              "label": "S9"
            }
          ]
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 2,
          "step_id": "p10",
          "status": "running",
          "add_step": {
            "id": "p10",
            "label": "S10"
          }
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 3,
          "step_id": "p11",
          "status": "running",
          "add_step": {
            "id": "p11",
            "label": "S11"
          }
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "plan.step",
          "seq": 4,
          "step_id": "p1",
          "done": 4,
          "add_step": {
            "id": "p2",
            "label": "dup"
          }
        }
      ],
      "expected": {
        "v": 1,
        "status": "running",
        "last_seq": 4,
        "plan": {
          "version": 1,
