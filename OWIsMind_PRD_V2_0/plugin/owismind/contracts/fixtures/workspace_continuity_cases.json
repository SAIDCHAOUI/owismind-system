{
  "name": "workspace_continuity_cases",
  "description": "Studio continuity (studio.continue / studio.carry / widget.remove / replaces) shared by backend (workspace/protocol.py + reducer.py) and frontend (composables/workspaceModel.js). 'normalize_cases': agent-stream normalization (normalize_op), expected null when rejected. 'reducer_cases': fold 'events' from the empty state (studio.carry is the backend-built op, accepted by the reducers) and compare with 'expected' (deep equality).",
  "normalize_cases": [
    {
      "name": "studio_continue_remove_deduped",
      "input": {
        "v": 1,
        "op": "studio.continue",
        "seq": 1,
        "ts": 1.0,
        "remove": [
          "w1",
          "w1",
          "BAD",
          3,
          "w2"
        ]
      },
      "default_ts": null,
      "expected": {
        "type": "workspace",
        "v": 1,
        "op": "studio.continue",
        "seq": 1,
        "ts": 1.0,
        "remove": [
          "w1",
          "w2"
        ]
      }
    },
    {
      "name": "studio_continue_empty",
      "input": {
        "v": 1,
        "op": "studio.continue",
        "seq": 2,
        "remove": []
      },
      "default_ts": 4.0,
      "expected": {
        "type": "workspace",
        "v": 1,
        "op": "studio.continue",
        "seq": 2,
        "ts": 4.0
      }
    },
    {
      "name": "studio_continue_remove_capped",
      "input": {
        "v": 1,
        "op": "studio.continue",
        "seq": 3,
        "remove": [
          "w1",
          "w2",
          "w3",
          "w4",
          "w5",
          "w6",
          "w7",
          "w8",
          "w9",
          "w10",
          "w11",
          "w12",
          "w13",
          "w14",
          "w15",
          "w16",
          "w17",
          "w18",
          "w19"
        ]
      },
      "default_ts": null,
      "expected": {
        "type": "workspace",
        "v": 1,
        "op": "studio.continue",
        "seq": 3,
        "remove": [
          "w1",
          "w2",
          "w3",
          "w4",
          "w5",
          "w6",
          "w7",
          "w8",
          "w9",
          "w10",
          "w11",
          "w12"
        ]
      }
    },
    {
      "name": "widget_remove",
      "input": {
        "v": 1,
        "op": "widget.remove",
        "seq": 4,
        "id": "w3",
        "extra": 1
      },
      "default_ts": null,
      "expected": {
        "type": "workspace",
        "v": 1,
        "op": "widget.remove",
        "seq": 4,
        "id": "w3"
      }
    },
    {
      "name": "widget_remove_missing_id_rejected",
      "input": {
        "v": 1,
        "op": "widget.remove",
        "seq": 5
      },
      "default_ts": null,
      "expected": null
    },
    {
      "name": "studio_carry_rejected_on_agent_stream",
      "input": {
        "v": 1,
        "op": "studio.carry",
        "seq": 6,
        "base_exchange_id": "ex-base",
        "widgets": []
      },
      "default_ts": null,
      "expected": null
    },
    {
      "name": "widget_add_replaces_kept",
      "input": {
        "v": 1,
        "op": "widget.add",
        "seq": 7,
        "replaces": "w1",
        "id": "w2",
        "kind": "text",
        "title": "Text w2",
        "text": "Body w2"
      },
      "default_ts": null,
      "expected": {
        "type": "workspace",
        "v": 1,
        "op": "widget.add",
        "seq": 7,
        "id": "w2",
        "kind": "text",
        "title": "Text w2",
        "text": "Body w2",
        "replaces": "w1"
      }
    },
    {
      "name": "widget_add_replaces_self_or_invalid_dropped",
      "input": {
        "v": 1,
        "op": "widget.add",
        "seq": 8,
        "replaces": "w2",
        "id": "w2",
        "kind": "text",
        "title": "Text w2",
        "text": "Body w2"
      },
      "default_ts": null,
      "expected": {
        "type": "workspace",
        "v": 1,
        "op": "widget.add",
        "seq": 8,
        "id": "w2",
        "kind": "text",
        "title": "Text w2",
        "text": "Body w2"
      }
    },
    {
      "name": "widget_add_origin_dropped",
      "input": {
        "v": 1,
        "op": "widget.add",
        "seq": 9,
        "origin": "ex-1",
        "id": "w3",
        "kind": "text",
        "title": "Text w3",
        "text": "Body w3"
      },
      "default_ts": null,
      "expected": {
        "type": "workspace",
        "v": 1,
        "op": "widget.add",
        "seq": 9,
        "id": "w3",
        "kind": "text",
        "title": "Text w3",
        "text": "Body w3"
      }
    }
  ],
  "reducer_cases": [
    {
      "name": "carry_prepends_and_summary_skips_origin",
      "description": "studio.carry prepends the base widgets before the run's widgets, sets base_exchange_id; summary.sql_ids skips carried widgets (their sql_id belongs to the origin exchange).",
      "events": [
        {
          "type": "workspace",
          "v": 1,
          "op": "studio.carry",
          "seq": 1,
          "ts": 0.5,
          "base_exchange_id": "ex-base",
          "widgets": [
            {
              "id": "w1",
              "kind": "chart",
              "title": "Chart w1",
              "sql_id": "s2q1",
              "chart": {
                "type": "bar",
                "x": "m",
                "y": [
                  "v"
                ]
              },
              "origin": "ex-base",
              "binding": "explicit"
            },
            {
              "id": "w2",
              "kind": "text",
              "title": "Text w2",
              "text": "Body w2",
              "role": "scope",
              "origin": "ex-base"
            }
          ]
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "widget.add",
          "seq": 2,
          "id": "w3",
          "kind": "chart",
          "title": "Chart w3",
          "sql_id": "s1q1",
          "chart": {
            "type": "bar",
            "x": "m",
            "y": [
              "v"
            ]
          },
          "step_id": "p1"
        },
        {
          "type": "workspace",
          "v": 1,
          "op": "prov.set",
          "seq": 3,
          "sql_id": "s1q1",
          "agent_key": "revenue_expert",
          "tool": "semantic-model-query",
          "success": true
        }
      ],
      "expected": {
        "v": 1,
        "status": "running",
        "last_seq": 3,
        "plan": null,
        "notes": [],
        "widgets": [
          {
            "id": "w1",
            "kind": "chart",
            "title": "Chart w1",
            "sql_id": "s2q1",
            "chart": {
              "type": "bar",
              "x": "m",
              "y": [
                "v"
              ]
            },
            "binding": "explicit",
            "origin": "ex-base"
          },
          {
            "id": "w2",
            "kind": "text",
            "title": "Text w2",
            "role": "scope",
            "text": "Body w2",
            "origin": "ex-base"
          },
          {
            "id": "w3",
            "kind": "chart",
            "title": "Chart w3",
            "step_id": "p1",
            "sql_id": "s1q1",
            "chart": {
              "type": "bar",
              "x": "m",
              "y": [
                "v"
              ]
            },
            "binding": "explicit"
          }
        ],
        "provenance": {
          "s1q1": {
            "agent_key": "revenue_expert",
            "tool": "semantic-model-query",
            "success": true
          }
        },
        "summary": {
          "widget_ids_by_step": {
            "p1": [
              "w3"
            ]
          },
          "sql_ids": [
            "s1q1"
          ]
        },
        "base_exchange_id": "ex-base"
      }
    },
